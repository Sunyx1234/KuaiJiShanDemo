# 本地开发保留 false，继续读取 public/assets/videos 下的素材。
# Netlify 生产环境设置为 true，视频地址将由 Netlify Function 临时签发。
VITE_USE_OSS_SIGNED_VIDEOS=false

# 以下变量只供 Netlify Function 使用，真实值仅填写在 Netlify 环境变量中。
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=ztvideos
OSS_REGION=oss-cn-shanghai
OSS_VIDEO_PREFIX=chint-dashboard/videos
