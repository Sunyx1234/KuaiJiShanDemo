# 本地开发保留 false，继续读取 public/assets/videos 下的素材。
# Netlify 生产环境设置为 true，视频地址将由 Netlify Function 临时签发。
VITE_USE_OSS_SIGNED_VIDEOS=false

# 以下变量只供 Netlify Function 使用，真实值仅填写在 Netlify 环境变量中。
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=ztvideos
OSS_REGION=oss-cn-shanghai
OSS_VIDEO_PREFIX=chint-dashboard/videos

# 告警工单闭环：以下变量只配置在 Netlify，禁止使用 VITE_ 前缀。
PUBLIC_SITE_URL=https://tiny-bienenstitch-386238.netlify.app
WORK_ORDER_ADMIN_PIN=

# 飞书企业自建应用。应用需启用机器人能力，并开通“以应用的身份发消息”权限。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 推荐先使用 email；也支持 open_id、user_id 或 union_id。
FEISHU_RECEIVER_ID_TYPE=email
FEISHU_RECEIVER_ID=
FEISHU_RECEIVER_NAME=现场责任人
FEISHU_RECEIVER_DEPARTMENT=安全生产部

# 第一阶段短信为辅助通道占位；接入真实供应商后再设置。
SMS_PROVIDER_CONFIGURED=
