# 默认通过服务端签发 OSS 视频地址，本地 Vite 代理至现有视频服务。
# 仅本地开发且已准备 public/assets/videos 素材时可设置为 false；生产始终使用视频服务。
VITE_USE_OSS_SIGNED_VIDEOS=true

# 以下变量只供服务端函数使用，真实值仅填写在部署平台的环境变量中。
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=ztvideos
OSS_REGION=oss-cn-shanghai
OSS_VIDEO_PREFIX=chint-dashboard/videos

# 告警工单闭环：以下变量只配置在部署平台，禁止使用 VITE_ 前缀。
# 部署成功后填写会稽山项目的正式访问地址，并重新部署。
PUBLIC_SITE_URL=
WORK_ORDER_ADMIN_PIN=

# 飞书企业自建应用。应用需启用机器人能力，并开通“以应用的身份发消息”权限。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 推荐先使用 email；也支持 open_id、user_id 或 union_id。
FEISHU_RECEIVER_ID_TYPE=email
FEISHU_RECEIVER_ID=
FEISHU_RECEIVER_NAME=现场责任人
FEISHU_RECEIVER_DEPARTMENT=安全生产部

# 第一阶段短信为辅助通道占位；接入真实供应商后再设置。
SMS_PROVIDER_CONFIGURED=
